# Copy to `.env` and fill in. `.env` is gitignored; this file is the record of
# what a working build needs.
#
# Expo strips every variable that does not start with EXPO_PUBLIC_ before the
# bundle is built, so REACT_APP_* (Create React App) and NEXT_PUBLIC_* (Next.js)
# never reach the app. This prefix is the only one that works here.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The backend. Without it a release build points the phone at itself; see
# API_NOT_CONFIGURED in src/api/client.ts.
EXPO_PUBLIC_API_URL=

# RevenueCat publishable SDK keys, from app.revenuecat.com → Project → API keys.
# These are meant to ship inside the binary. The secret v2 API key belongs to
# the backend and must never appear in this file.
#
# The Test Store key serves fake products so the paywall and the kosmiq_pro
# entitlement can be built before anything exists in App Store Connect. It is
# used only when __DEV__ is true — src/purchases/config.ts refuses to configure
# a release build with it, because an app shipped on this key sells nothing and
# reports every customer as entitled.
EXPO_PUBLIC_REVENUECAT_TEST_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
