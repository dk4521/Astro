# Copy to `.env` and fill in. `.env` is gitignored; this file is committed, so
# never put a real key here.
#
#   cp .env.example .env
#
# Real environment variables take precedence over .env, so a deployment's
# dashboard settings are never overridden by a stray file in the image.

# --- Required for the interpretation layer -----------------------------------
# From https://aistudio.google.com/apikey — AI Studio keys start with "AIza".
# The deterministic endpoints (/v1/chart, /v1/dasha, ...) work without this;
# only /v1/interpret and /v1/chat need it.
GEMINI_API_KEY=

# --- Optional ----------------------------------------------------------------

# Primary model. Not the newest Flash on purpose: gemini-3.7-flash was the most
# capacity-starved on the free tier and rejects the MINIMAL thinking level that
# makes readings feel instant.
# ASTRO_MODEL=gemini-3.5-flash

# Tried in order when the primary returns 503/429. Free-tier capacity is the
# dominant failure mode — roughly half of all calls during live testing came
# back "experiencing high demand".
# ASTRO_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite

# MINIMAL | LOW | MEDIUM | HIGH. Explaining settled data is not a reasoning
# problem, and thinking dominates latency. Measured on gemini-3.5-flash, same
# question: LOW = 24.8s to the first streamed token; MINIMAL = 1.8s, with no
# loss of depth. gemini-3.7-flash rejects MINIMAL and is downgraded to LOW
# automatically.
# ASTRO_THINKING_LEVEL=MINIMAL

# Thinking tokens are drawn from this budget, not counted separately — a
# reading spends ~1300 thinking and ~400 answering. At 2000 readings were
# silently truncated mid-sentence.
# ASTRO_MAX_TOKENS=8000

# Lower keeps readings grounded and consistent; higher makes them more florid.
# ASTRO_TEMPERATURE=0.7

# Ephemeris kernel location. Defaults to backend/data/de440s.bsp.
# EPHEMERIS_DIR=
# EPHEMERIS_FILE=de440s.bsp

# Narrow before launch — "*" leaves the API open to any web origin.
# CORS_ORIGINS=*
